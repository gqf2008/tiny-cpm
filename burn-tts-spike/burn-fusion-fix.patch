+use std::sync::atomic::{AtomicBool, Ordering};
+
+static STALE_PLAN: AtomicBool = AtomicBool::new(false);
+
+/// Set when a fused optimization detects that its cached trace is stale under
+/// the current relative numbering (see `burn-cubecl-fusion`'s
+/// `ElemwiseOptimization::run` fallback path). The stream processor checks this
+/// after each plan execution and drops all cached plans so the next occurrence
+/// re-explores against the current numbering instead of replaying the stale one.
+pub fn mark_stale_plan() {
+    STALE_PLAN.store(true, Ordering::Relaxed);
+}
+
+/// Returns and clears the stale-plan flag.
+pub fn take_stale_plan() -> bool {
+    STALE_PLAN.swap(false, Ordering::Relaxed)
+}
+
